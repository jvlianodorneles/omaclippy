#!/usr/bin/env bash
# Omaclippy CLI Helper - Desktop Companion Controller
# Security hardened: Resolves trusted executables once from allowlist and fails closed.

set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve trusted omarchy-shell binary
OMARCHY_SHELL=""
for cand in /usr/share/omarchy/bin/omarchy-shell /usr/bin/omarchy-shell /usr/local/bin/omarchy-shell; do
  if [[ -f "$cand" && -x "$cand" ]]; then
    OMARCHY_SHELL="$cand"
    break
  fi
done

# Resolve trusted python3 binary
PYTHON3_BIN=""
for cand in /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
  if [[ -f "$cand" && -x "$cand" ]]; then
    PYTHON3_BIN="$cand"
    break
  fi
done

usage() {
  cat << USAGE
Omaclippy CLI - Control your desktop Clippy companion

Usage:
  omaclippy <command|animation> [message]

Direct Animation & Speech Triggers:
  omaclippy tech [message]      Computer transformation (GetTechy)
  omaclippy art [message]       Painter with palette (GetArtsy)
  omaclippy write [message]     Writing on notepad (Writing)
  omaclippy save [message]      Floppy disk save (Save)
  omaclippy mail [message]      Paper airplane (SendMail)
  omaclippy search [message]    Magnifying glass (Searching)
  omaclippy print [message]     Matrix printer (Print)
  omaclippy process [message]   Spinning gears (Processing)
  omaclippy trash [message]     Trash can (EmptyTrash)
  omaclippy atom [message]      Atomic orbit (IdleAtom)
  omaclippy sleep [message]     Snooze / sleeping (IdleSnooze)
  omaclippy thinking [message]  Thinking with question marks (Thinking)
  omaclippy alert [message]     Warning screen tap (Alert)
  omaclippy done [message]      Celebration checkmark (Congratulate)
  omaclippy wave [message]      Waving hand (Wave)
  omaclippy <AnyAnimation> [message]

General Commands:
  omaclippy prompt              Open interactive mini floating AI prompt
  omaclippy react <anim> [text] Trigger any animation with speech balloon
  omaclippy speak <text>        Show speech balloon with text
  omaclippy play <animation>    Play specific animation
  omaclippy tip                 Show speech balloon with random retro tip
  omaclippy toggle              Toggle companion On / Off
  omaclippy on                  Activate companion
  omaclippy off                 Pause companion
  omaclippy reset               Reset Clippy position to default corner
  omaclippy setScale <scale>    Change scale (small, normal, large, giant)
  omaclippy setMode <mode>      Change mode (companion, roam, perch)
  omaclippy status              Display current JSON status
  omaclippy mcp                 Run MCP Server for Claude / Antigravity

Examples:
  omaclippy tech "Compiling project on Arch Linux..."
  omaclippy save "Commit saved to disk!"
  omaclippy done "All tests passed successfully!"
USAGE
}

cmd="${1:-}"

if [[ -z "$cmd" || "$cmd" == "--help" || "$cmd" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$cmd" == "mcp" ]]; then
  if [[ -z "$PYTHON3_BIN" ]]; then
    echo "omaclippy: python3 executable not found in trusted directories" >&2
    exit 1
  fi
  exec "$PYTHON3_BIN" "$DIR/mcp_server.py"
fi

if [[ -z "$OMARCHY_SHELL" ]]; then
  echo "omaclippy: omarchy-shell executable not found in trusted directories" >&2
  exit 1
fi

shift || true

# Bounded string truncation (max 500 chars)
truncate_str() {
  local str="$1"
  echo "${str:0:500}"
}

case "$cmd" in
  react)
    anim="${1:-Explain}"
    msg=$(truncate_str "${2:-}")
    exec "$OMARCHY_SHELL" dorneles.omaclippy react "$anim" "$msg"
    ;;
  prompt)
    exec "$OMARCHY_SHELL" dorneles.omaclippy prompt
    ;;
  speak)
    msg=$(truncate_str "${1:-Hello!}")
    exec "$OMARCHY_SHELL" dorneles.omaclippy speak "$msg"
    ;;
  play)
    exec "$OMARCHY_SHELL" dorneles.omaclippy play "${1:-random}"
    ;;
  tip)
    exec "$OMARCHY_SHELL" dorneles.omaclippy tip
    ;;
  toggle)
    exec "$OMARCHY_SHELL" dorneles.omaclippy toggle
    ;;
  on)
    exec "$OMARCHY_SHELL" dorneles.omaclippy on
    ;;
  off)
    exec "$OMARCHY_SHELL" dorneles.omaclippy off
    ;;
  reset)
    exec "$OMARCHY_SHELL" dorneles.omaclippy resetPosition
    ;;
  setScale)
    exec "$OMARCHY_SHELL" dorneles.omaclippy setScale "$1"
    ;;
  setMode)
    exec "$OMARCHY_SHELL" dorneles.omaclippy setMode "$1"
    ;;
  status)
    exec "$OMARCHY_SHELL" dorneles.omaclippy status
    ;;
  *)
    # Direct animation / alias invocation
    if [[ $# -eq 0 ]]; then
      exec "$OMARCHY_SHELL" dorneles.omaclippy play "$cmd"
    else
      msg=$(truncate_str "$1")
      exec "$OMARCHY_SHELL" dorneles.omaclippy react "$cmd" "$msg"
    fi
    ;;
esac
