#!/usr/bin/env bash
# Omaclippy Git Pre-Push Hook
# Place in .git/hooks/pre-push or global git hooks

set -eo pipefail

OMACLIPPY_BIN=""
for cand in "$HOME/.config/omarchy/plugins/dorneles.omaclippy/bin/omaclippy" /usr/local/bin/omaclippy /usr/bin/omaclippy; do
  if [[ -f "$cand" && -x "$cand" ]]; then
    OMACLIPPY_BIN="$cand"
    break
  fi
done

if [[ -n "$OMACLIPPY_BIN" ]]; then
  "$OMACLIPPY_BIN" react SendMail "Pushing commits to remote repository..." >/dev/null 2>&1 &
else
  for cand in /usr/share/omarchy/bin/omarchy-shell /usr/bin/omarchy-shell /usr/local/bin/omarchy-shell; do
    if [[ -f "$cand" && -x "$cand" ]]; then
      "$cand" dorneles.omaclippy play SendMail >/dev/null 2>&1 &
      break
    fi
  done
fi
